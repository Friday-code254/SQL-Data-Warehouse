# Copy to .env and configure locally. Never commit credentials.
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=DataWarehouse
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERTIFICATE=yes
SQLSERVER_TRUSTED_CONNECTION=yes
# For SQL authentication set SQLSERVER_TRUSTED_CONNECTION=no and provide:
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# When the SQL Server service/container sees the files at a different location:
# SQLSERVER_DATASET_ROOT=C:\\sql\\dwh_project\\01_datasets
